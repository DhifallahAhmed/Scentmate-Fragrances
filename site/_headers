# Netlify response headers.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # Everything comes from this site. 'wasm-unsafe-eval' lets the browser compile the ONNX Runtime
  # WebAssembly engine (it does NOT allow JavaScript eval()). worker-src: the model worker + offline worker.
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Content-hashed / versioned files never change -> cache for a year.
/model/files/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Small files that point at the hashed ones -> always re-check.
/model/config.json
  Cache-Control: public, max-age=0, must-revalidate
/worker.js
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: no-cache
