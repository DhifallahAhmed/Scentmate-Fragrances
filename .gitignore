# Node (Netlify Function dependencies are installed by Netlify)
node_modules/
package-lock.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# Training outputs (re-created by train.py in ~1 minute)
artifacts/

# Dataset — scraped third-party data, kept out of the public repo by default.
# Delete these two lines if you want to version it (and have the right to publish it).
data/*.json
!data/.gitkeep

# Exported feedback / local databases
*.db
feedback.jsonl

# Secrets / local tooling
.env
.netlify/
.claude/
